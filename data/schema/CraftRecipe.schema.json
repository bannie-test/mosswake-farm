{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mosswake/CraftRecipe.schema.json",
  "title": "CraftRecipe",
  "x-kind": "static-support",
  "x-file": "craft_recipes.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(craft)_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "itemId",
              "qty"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              },
              "rarity": {
                "enum": [
                  "common",
                  "uncommon",
                  "rare",
                  "epic",
                  "legendary",
                  "mythical"
                ]
              }
            },
            "required": [
              "tag",
              "qty"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "coins": {
      "type": "integer",
      "minimum": 0
    },
    "hours": {
      "type": "number",
      "minimum": 0
    },
    "output": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "itemId",
        "qty"
      ],
      "additionalProperties": false
    },
    "station": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(bld)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "unlock": {
      "type": "object",
      "properties": {
        "start": {
          "type": "boolean"
        },
        "playerLevel": {
          "type": "integer",
          "minimum": 1
        },
        "quest": {
          "type": "string",
          "pattern": "^(quest)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "questState": {
          "enum": [
            "started",
            "completed"
          ]
        },
        "building": {
          "type": "string",
          "pattern": "^(bld)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "firstResearchOf": {
          "type": "string",
          "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "blueprint": {
          "type": "string",
          "pattern": "^(bp)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "researchLevel": {
          "type": "integer",
          "minimum": 1
        },
        "npcReputation": {
          "type": "object",
          "properties": {
            "npcId": {
              "type": "string",
              "pattern": "^(npc)_[a-z0-9]+(_[a-z0-9]+)*$"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "required": [
            "npcId",
            "level"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "inputs",
    "coins",
    "hours",
    "output",
    "station",
    "unlock"
  ],
  "additionalProperties": false
}
