{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mosswake/OrderDefinition.schema.json",
  "title": "OrderDefinition",
  "x-kind": "runtime-shape",
  "x-file": null,
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^ord_[0-9]{6}$"
    },
    "npcId": {
      "type": "string",
      "pattern": "^(npc)_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "category": {
      "enum": [
        "delivery",
        "special"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special|bug|fish)_[a-z0-9]+(_[a-z0-9]+)*$"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "minQuality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": [
          "itemId",
          "qty",
          "minQuality"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 3
    },
    "rewards": {
      "type": "object",
      "properties": {
        "coins": {
          "type": "integer",
          "minimum": 0
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "reputation": {
          "type": "integer",
          "minimum": 0
        },
        "bonusItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special|bug|fish)_[a-z0-9]+(_[a-z0-9]+)*$"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "itemId",
              "qty"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "coins",
        "xp",
        "reputation",
        "bonusItems"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "pinnedForSpirit": {
      "type": "boolean"
    },
    "slot": {
      "type": "string",
      "pattern": "^npc_[a-z0-9_]+/[0-9]+$",
      "description": "The board slot this order fills (runtime only)."
    }
  },
  "required": [
    "orderId",
    "npcId",
    "category",
    "lines",
    "rewards",
    "createdAt",
    "expiresAt",
    "pinnedForSpirit"
  ],
  "additionalProperties": false
}
