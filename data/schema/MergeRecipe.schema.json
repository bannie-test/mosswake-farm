{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mosswake/MergeRecipe.schema.json",
  "title": "MergeRecipe",
  "x-kind": "static",
  "x-file": "merge_recipes.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(merge)_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "rarity": {
      "enum": [
        "basic",
        "advanced",
        "rare",
        "epic",
        "legendary",
        "mythical"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "itemId",
          "qty"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "output": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "itemId",
        "qty"
      ],
      "additionalProperties": false
    },
    "station": {
      "type": "string",
      "pattern": "^(bld)_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "minStationLevel": {
      "type": "integer",
      "minimum": 1
    },
    "allowLucky": {
      "type": "boolean"
    },
    "unlock": {
      "type": "object",
      "properties": {
        "start": {
          "type": "boolean"
        },
        "playerLevel": {
          "type": "integer",
          "minimum": 1
        },
        "quest": {
          "type": "string",
          "pattern": "^(quest)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "questState": {
          "enum": [
            "started",
            "completed"
          ]
        },
        "building": {
          "type": "string",
          "pattern": "^(bld)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "firstResearchOf": {
          "type": "string",
          "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "blueprint": {
          "type": "string",
          "pattern": "^(bp)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "researchLevel": {
          "type": "integer",
          "minimum": 1
        },
        "npcReputation": {
          "type": "object",
          "properties": {
            "npcId": {
              "type": "string",
              "pattern": "^(npc)_[a-z0-9]+(_[a-z0-9]+)*$"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "required": [
            "npcId",
            "level"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "overrides": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "rarity",
    "inputs",
    "output",
    "station",
    "minStationLevel",
    "allowLucky",
    "unlock"
  ],
  "additionalProperties": false
}
