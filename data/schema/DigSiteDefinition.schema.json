{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mosswake/DigSiteDefinition.schema.json",
  "title": "DigSiteDefinition",
  "x-kind": "static-support",
  "x-file": "dig_sites.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(site)_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "grid": {
      "type": "object",
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "layers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "husks": {
      "type": "integer",
      "minimum": 1
    },
    "huskCondition": {
      "type": "array",
      "items": {
        "enum": [
          "muddy",
          "cracked"
        ]
      }
    },
    "rootSense": {
      "type": "object",
      "properties": {
        "hot": {
          "type": "integer"
        },
        "warm": {
          "type": "integer"
        }
      },
      "required": [
        "hot",
        "warm"
      ],
      "additionalProperties": false
    },
    "guaranteedLoot": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special|bug|fish)_[a-z0-9]+(_[a-z0-9]+)*$"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "itemId",
          "qty"
        ],
        "additionalProperties": false
      }
    },
    "digsPerKit": {
      "type": "integer",
      "minimum": 1
    },
    "unlock": {
      "type": "object",
      "properties": {
        "start": {
          "type": "boolean"
        },
        "playerLevel": {
          "type": "integer",
          "minimum": 1
        },
        "quest": {
          "type": "string",
          "pattern": "^(quest)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "questState": {
          "enum": [
            "started",
            "completed"
          ]
        },
        "building": {
          "type": "string",
          "pattern": "^(bld)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "firstResearchOf": {
          "type": "string",
          "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special|bug|fish)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "blueprint": {
          "type": "string",
          "pattern": "^(bp)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "researchLevel": {
          "type": "integer",
          "minimum": 1
        },
        "npcReputation": {
          "type": "object",
          "properties": {
            "npcId": {
              "type": "string",
              "pattern": "^(npc)_[a-z0-9]+(_[a-z0-9]+)*$"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "required": [
            "npcId",
            "level"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "grid",
    "layers",
    "husks",
    "huskCondition",
    "rootSense",
    "guaranteedLoot",
    "digsPerKit",
    "unlock"
  ],
  "additionalProperties": false
}
