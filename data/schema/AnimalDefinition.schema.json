{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mosswake/AnimalDefinition.schema.json",
  "title": "AnimalDefinition",
  "x-kind": "static",
  "x-file": "animals.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(animal)_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "species": {
      "type": "string"
    },
    "housing": {
      "type": "string",
      "pattern": "^(bld)_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "buyCost": {
      "type": "integer",
      "minimum": 0
    },
    "stageHours": {
      "type": "object",
      "properties": {
        "baby": {
          "type": "number"
        },
        "juvenile": {
          "type": "number"
        },
        "elderAfterDays": {
          "type": "number"
        }
      },
      "required": [
        "baby",
        "juvenile",
        "elderAfterDays"
      ],
      "additionalProperties": false
    },
    "feed": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
            },
            "qtyPer8h": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "itemId",
            "qtyPer8h"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "hungerDrainPerHour": {
      "type": "number",
      "minimum": 0
    },
    "happinessDecayPerHour": {
      "type": "number",
      "minimum": 0
    },
    "renewable": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^(prod)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "intervalHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "needsTool": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(tool)_[a-z0-9]+(_[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "itemId",
        "intervalHours",
        "qty",
        "needsTool"
      ],
      "additionalProperties": false
    },
    "oneTime": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string"
          },
          "itemId": {
            "type": "string",
            "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
          }
        },
        "required": [
          "event",
          "itemId"
        ],
        "additionalProperties": false
      }
    },
    "geneId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(gene)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "breedingRuleId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(breed)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "defaultRarity": {
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "mythical"
      ]
    },
    "unlock": {
      "type": "object",
      "properties": {
        "start": {
          "type": "boolean"
        },
        "playerLevel": {
          "type": "integer",
          "minimum": 1
        },
        "quest": {
          "type": "string",
          "pattern": "^(quest)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "questState": {
          "enum": [
            "started",
            "completed"
          ]
        },
        "building": {
          "type": "string",
          "pattern": "^(bld)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "firstResearchOf": {
          "type": "string",
          "pattern": "^(seed|crop|prod|merged|food|gene|lucky|mat|spirit|embryo|quest|tool|special)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "blueprint": {
          "type": "string",
          "pattern": "^(bp)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "researchLevel": {
          "type": "integer",
          "minimum": 1
        },
        "npcReputation": {
          "type": "object",
          "properties": {
            "npcId": {
              "type": "string",
              "pattern": "^(npc)_[a-z0-9]+(_[a-z0-9]+)*$"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "required": [
            "npcId",
            "level"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "species",
    "housing",
    "buyCost",
    "stageHours",
    "feed",
    "hungerDrainPerHour",
    "happinessDecayPerHour",
    "renewable",
    "oneTime",
    "geneId",
    "breedingRuleId",
    "defaultRarity",
    "unlock"
  ],
  "additionalProperties": false
}
