extends Node
## NPC delivery orders and the reward pipeline (GDD section 8). Autoload: Orders.
## Orders are generated by the algorithm of section 8, "Order generation algorithm".

signal changed
signal delivered(order: Dictionary)

var orders: Array = []                 # open OrderDefinition dictionaries (each carries its "slot")
var slot_refill_at: Dictionary = {}    # "npc_id/slot" -> game minute the slot refills
var _serial := 0
var _last_gift_day := 0


func _ready() -> void:
	Sim.register(self)
	Sim.dawn.connect(_on_dawn)
	GameState.leveled_up.connect(func(_level: int) -> void: fill_slots())
	SaveGame.register_section("orders", self)


func cfg() -> Dictionary:
	return GameData.config["orders"]


func new_game() -> void:
	orders.clear()
	slot_refill_at.clear()
	_serial = 0
	_last_gift_day = 0
	fill_slots()


func advance(delta_minutes: float) -> void:
	var due := false
	for key: String in slot_refill_at.keys():
		if Sim.game_minute + delta_minutes >= float(slot_refill_at[key]):
			slot_refill_at.erase(key)
			due = true
	if due:
		fill_slots()


func board_open() -> bool:
	return GameState.is_unlocked("feature_order_board")


func fill_slots() -> void:
	if not board_open():
		return
	var added := false
	for npc_id: String in GameData.ids("npcs"):
		if not Unlocks.npc_met(npc_id):
			continue
		for slot: int in range(int(GameData.def("npcs", npc_id)["orderRules"]["deliverySlots"])):
			if orders.size() >= int(cfg()["maxDeliveryShown"]):
				break
			var key := "%s/%d" % [npc_id, slot + 1]
			if slot_refill_at.has(key) or orders.any(func(o: Dictionary) -> bool: return o["slot"] == key):
				continue
			var order := generate(npc_id)
			if order.is_empty():
				continue
			order["slot"] = key
			orders.append(order)
			added = true
	if added:
		changed.emit()


# ------------------------------------------------------------------ production model
## Goods the player can make right now: owns or can buy the seed, owns the animal, or knows a
## recipe whose inputs are all producible.
func producible() -> Dictionary:
	var out := {}
	for plant_id: String in GameData.ids("plants"):
		var p: Dictionary = GameData.plant(plant_id)
		if Unlocks.is_met(p["unlock"]) and (Inventory.count(p["seedItemId"]) > 0 or _seed_sold(p["seedItemId"])):
			out[p["productItemId"]] = true
	for a: Dictionary in Animals.animals:
		if a["stage"] in ["adult", "elder"]:
			out[GameData.def("animals", a["animalId"])["renewable"]["itemId"]] = true
	var grew := true
	while grew:
		grew = false
		for recipe_id: String in GameData.ids("merge_recipes"):
			var r: Dictionary = GameData.def("merge_recipes", recipe_id)
			if out.has(r["output"]["itemId"]) or not Unlocks.recipe_known(recipe_id):
				continue
			if r["inputs"].all(func(i: Dictionary) -> bool: return out.has(i["itemId"])):
				out[r["output"]["itemId"]] = true
				grew = true
	return out


func _seed_sold(seed_item_id: String) -> bool:
	for npc_id: String in GameData.ids("npcs"):
		if Unlocks.npc_met(npc_id):
			for entry: Dictionary in Shop.entries(npc_id):
				if entry.get("itemId", "") == seed_item_id and Shop.is_open(entry):
					return true
	return false


## Units of a good the current farm can make in one game day: plots x yield, animals x rate,
## merge inputs. Uses what the player owns now, never theoretical maximums.
func capacity_per_24h(item_id: String) -> float:
	for plant_id: String in GameData.ids("plants"):
		var p: Dictionary = GameData.plant(plant_id)
		if p["productItemId"] == item_id:
			var harvests := 1
			var hours := float(p["growthHours"])
			if p["regrow"] != null and p["regrow"]["maxHarvests"] != null:
				harvests = int(p["regrow"]["maxHarvests"])
				hours += float(p["regrow"]["hours"]) * (harvests - 1)
			return Farm.plots.size() * int(p["yield"]["min"]) * harvests * 24.0 / hours
	var from_animals := 0.0
	for a: Dictionary in Animals.count_producing(item_id):
		var r: Dictionary = GameData.def("animals", a["animalId"])["renewable"]
		from_animals += int(r["qty"]) * 24.0 / float(r["intervalHours"])
	if from_animals > 0.0:
		return from_animals
	for recipe_id: String in GameData.ids("merge_recipes"):
		var r: Dictionary = GameData.def("merge_recipes", recipe_id)
		if r["output"]["itemId"] == item_id and Unlocks.recipe_known(recipe_id):
			var cap := INF
			for input: Dictionary in r["inputs"]:
				cap = minf(cap, capacity_per_24h(input["itemId"]) / int(input["qty"]))
			return cap * int(r["output"]["qty"])
	return 0.0


## Game hours of the whole farm's output an order needs.
func expected_production_hours(order: Dictionary) -> float:
	var days := 0.0
	for line: Dictionary in order["lines"]:
		var cap := capacity_per_24h(line["itemId"])
		if cap <= 0.0:
			return INF
		days += int(line["qty"]) / cap
	return days * 24.0


func needs_risky_merge(order: Dictionary) -> bool:
	for line: Dictionary in order["lines"]:
		for recipe_id: String in GameData.ids("merge_recipes"):
			var r: Dictionary = GameData.def("merge_recipes", recipe_id)
			if r["output"]["itemId"] == line["itemId"] and int(GameData.merge_config["baseRate"][r["rarity"]]) <= int(GameData.merge_config["baseRate"]["rare"]):
				return true
	return false


## The share of an order's goods value that is already in stock.
func stock_share(order: Dictionary) -> float:
	var value := 0.0
	var held := 0.0
	for line: Dictionary in order["lines"]:
		var unit := float(GameData.item(line["itemId"])["baseValue"])
		value += unit * int(line["qty"])
		held += unit * mini(int(line["qty"]), Inventory.count(line["itemId"]))
	return held / value if value > 0.0 else 1.0


func is_easy(order: Dictionary) -> bool:
	return stock_share(order) >= float(cfg()["easyStockShare"])


# ------------------------------------------------------------------ generation (section 8)
func generate(npc_id: String) -> Dictionary:
	var npc: Dictionary = GameData.def("npcs", npc_id)
	var rules: Dictionary = npc["orderRules"]
	var rng := GameState.stream("orders")
	var level: int = GameState.player["level"]
	# 1-2. what the player can make, filtered by what this NPC wants
	var requested := {}
	for o: Dictionary in orders:
		for line: Dictionary in o["lines"]:
			requested[line["itemId"]] = true
	var pool: Array = []
	for item_id: String in producible():
		var def: Dictionary = GameData.item(item_id)
		if int(def["tier"]) > int(cfg()["deliveryMaxTier"]) or requested.has(item_id) or capacity_per_24h(item_id) <= 0.0:
			continue
		if rules["tags"].any(func(tag: String) -> bool: return def["tags"].has(tag)):
			pool.append(item_id)
	pool.sort()                                   # a stable order keeps generation reproducible
	if pool.is_empty():
		return fallback_order(npc_id)
	# 3. how big
	var b: Dictionary = cfg()["budget"]
	var budget: float = (float(b["base"]) + float(b["perLevel"]) * level + float(b["perLevelSq"]) * level * level) * float(rules["sizeFactor"])
	for attempt: int in range(int(cfg()["regenerateAttempts"])):
		var count := mini(pool.size(), rng.randi_range(1, int(rules["maxLines"])))
		var picked := _weighted_pick(pool, count, npc, level, rng)
		# 4. quantities, limited by real capacity
		var lines: Array = []
		for item_id: String in picked:
			var qty := roundi(budget / picked.size() / float(GameData.item(item_id)["baseValue"]))
			var cap := floori(float(cfg()["capacityShare"]) * capacity_per_24h(item_id))
			lines.append({"itemId": item_id, "qty": clampi(qty, 1, maxi(1, cap))})
		var order := build_order(npc_id, lines)
		# 5. fairness checks
		if expected_production_hours(order) > float(cfg()["maxProductionHours"]["delivery"]):
			continue
		if needs_risky_merge(order) and orders.any(needs_risky_merge):
			continue
		if not is_easy(order) and not orders.any(is_easy):      # keep one easy order on the board
			continue
		return order
	return fallback_order(npc_id)


func _weighted_pick(pool: Array, count: int, npc: Dictionary, level: int, rng: RngStream) -> Array:
	var left := pool.duplicate()
	var out: Array = []
	while out.size() < count and not left.is_empty():
		var weights: Array = []
		var total := 0.0
		for item_id: String in left:
			var def: Dictionary = GameData.item(item_id)
			var w := 1.0
			if npc["likes"].any(func(tag: String) -> bool: return def["tags"].has(tag)):
				w *= float(cfg()["likeWeight"])
			if level - Unlocks.item_unlock_level(item_id) < int(cfg()["noveltyLevels"]) and Unlocks.item_unlock_level(item_id) > 1:
				w *= float(cfg()["noveltyWeight"])       # new content shows up in orders straight away
			weights.append(w)
			total += w
		var roll := rng.randf() * total
		var chosen := left.size() - 1
		for i: int in range(left.size()):
			roll -= weights[i]
			if roll < 0.0:
				chosen = i
				break
		out.append(left[chosen])
		left.remove_at(chosen)
	return out


## 4-6 of the cheapest producible crop this NPC likes; any producible crop if they like none.
func fallback_order(npc_id: String) -> Dictionary:
	var npc: Dictionary = GameData.def("npcs", npc_id)
	var requested := {}
	for o: Dictionary in orders:
		for line: Dictionary in o["lines"]:
			requested[line["itemId"]] = true
	# rank: a crop nobody has asked for yet, then one this NPC likes, then the cheapest
	var best := ""
	var best_rank: Array = []
	for item_id: String in producible():
		var def: Dictionary = GameData.item(item_id)
		if def["category"] != "crop" or int(def["tier"]) > int(cfg()["deliveryMaxTier"]):
			continue
		var liked: bool = npc["orderRules"]["tags"].any(func(tag: String) -> bool: return def["tags"].has(tag))
		var rank: Array = [1 if requested.has(item_id) else 0, 0 if liked else 1, float(def["baseValue"]), item_id]
		if best == "" or rank < best_rank:
			best = item_id
			best_rank = rank
	if best == "":
		return {}
	var q: Dictionary = cfg()["fallbackQty"]
	return build_order(npc_id, [{"itemId": best, "qty": GameState.stream("orders").randi_range(int(q["min"]), int(q["max"]))}])


## An OrderDefinition with rewards from the section 10 formulas.
func build_order(npc_id: String, lines: Array, bonus_items: Array = []) -> Dictionary:
	var eco: Dictionary = GameData.config["economy"]
	var value := 0.0
	var out_lines: Array = []
	for line: Dictionary in lines:
		value += int(line["qty"]) * float(GameData.item(line["itemId"])["baseValue"])
		out_lines.append({"itemId": line["itemId"], "qty": int(line["qty"]), "minQuality": int(line.get("minQuality", 1))})
	_serial += 1
	return {
		"orderId": "ord_%06d" % _serial,
		"npcId": npc_id,
		"category": "delivery",
		"lines": out_lines,
		"rewards": {
			"coins": roundi(value * float(eco["saleRate"]["delivery"])),
			"xp": roundi(value * float(eco["xpRate"]["delivery"])),
			"reputation": int(GameData.config["reputation"]["delivery"]),
			"bonusItems": bonus_items.duplicate(true),
		},
		"createdAt": int(Sim.game_minute),
		"expiresAt": null,
		"pinnedForSpirit": false,
	}


# ------------------------------------------------------------------ board actions
func orders_for(npc_id: String) -> Array:
	return orders.filter(func(o: Dictionary) -> bool: return o["npcId"] == npc_id)


func find(order_id: String) -> Dictionary:
	for o: Dictionary in orders:
		if o["orderId"] == order_id:
			return o
	return {}


func can_deliver(order: Dictionary) -> bool:
	for line: Dictionary in order["lines"]:
		if Inventory.count(line["itemId"], int(line["minQuality"])) < int(line["qty"]):
			return false
	return true


## Hand over the goods and pay the rewards. Returns false and changes nothing when a line is short.
func deliver(order_id: String) -> bool:
	var order := find(order_id)
	if order.is_empty() or not can_deliver(order):
		return false
	for line: Dictionary in order["lines"]:
		Inventory.remove(line["itemId"], int(line["qty"]), int(line["minQuality"]))
	var rewards: Dictionary = order["rewards"]
	GameState.add_coins(int(rewards["coins"]))
	GameState.add_reputation(order["npcId"], int(rewards["reputation"]))
	for bonus: Dictionary in rewards["bonusItems"]:
		Inventory.add(bonus["itemId"], int(bonus["qty"]))
	GameState.player["stats"]["ordersCompleted"] += 1
	orders.erase(order)
	slot_refill_at[order["slot"]] = Sim.game_minute + float(cfg()["refillMinutes"]["completed"])
	GameState.add_xp(int(rewards["xp"]))
	delivered.emit(order)
	changed.emit()
	return true


## Orders carry no penalty: a dismissed slot simply refills later.
func dismiss(order_id: String) -> bool:
	var order := find(order_id)
	if order.is_empty():
		return false
	orders.erase(order)
	slot_refill_at[order["slot"]] = Sim.game_minute + float(cfg()["refillMinutes"]["dismissed"])
	changed.emit()
	return true


## Deadlock rule (section 10): a player with no coins, no seeds and nothing growing gets Carrot
## seeds from Mara, once per game day.
func _on_dawn(day: int) -> void:
	check_deadlock(day)


func check_deadlock(day: int) -> bool:
	var rule: Dictionary = GameData.config["economy"]["deadlock"]
	if day == _last_gift_day or GameState.coins() >= int(rule["coinsBelow"]) or Farm.anything_growing():
		return false
	for item_id: String in GameData.ids("items"):
		var def: Dictionary = GameData.item(item_id)
		if (def["category"] == "seed" or def["sellable"]) and Inventory.count(item_id) > 0:
			return false
	_last_gift_day = day
	Inventory.add(rule["giftItemId"], int(rule["giftQty"]))
	GameState.notice.emit("%s left you %d %s" % [GameData.def("npcs", rule["giverNpcId"])["name"].get_slice(" ", 0), int(rule["giftQty"]), GameData.item(rule["giftItemId"])["name"]])
	return true


# ------------------------------------------------------------------ save sections
func save_state() -> Array:
	return orders.duplicate(true)


func load_state(data: Array) -> void:
	orders = SaveGame.whole_numbers(data)
	for o: Dictionary in orders:
		_serial = maxi(_serial, int(o["orderId"].trim_prefix("ord_")))
	changed.emit()
